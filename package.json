{
  "name": "ik-ben-een-appel",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/run-local.mjs dev",
    "test:local": "node scripts/run-local.mjs test",
    "dev:private": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-private.ps1 -Environment dev",
    "test:private": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-private.ps1 -Environment test",
    "dev:private:mac": "bash scripts/start-private-macos.sh dev",
    "test:private:mac": "bash scripts/start-private-macos.sh test",
    "build": "vinext build",
    "start": "node scripts/run-local.mjs test",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test": "tsx --test tests/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "verify:dev": "node scripts/verify-dev-workflow.mjs",
    "backup:test": "node scripts/backup-local.mjs test",
    "backup:dev": "node scripts/backup-local.mjs dev",
    "backup:verify": "node scripts/verify-local-backup.mjs",
    "db:generate": "drizzle-kit generate",
    "vpn:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-vpn.ps1",
    "vpn:setup:mac": "bash scripts/setup-vpn-macos.sh",
    "vpn:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-vpn.ps1 -ShowPublicIp",
    "vpn:check:mac": "bash scripts/check-vpn-macos.sh --show-public-ip",
    "init-secrets": "node scripts/init-secrets.mjs dev && node scripts/init-secrets.mjs test",
    "verify:admin": "node scripts/verify-admin-actions.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "mammoth": "1.11.0",
    "next": "16.3.4",
    "pdfjs-dist": "5.4.149",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@rolldown/binding-win32-x64-msvc": "^1.0.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
