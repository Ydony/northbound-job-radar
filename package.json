{
  "name": "ik-ben-een-appel",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "indeed": "node scripts/indeed.mjs",
    "dev": "node scripts/run-local.mjs dev",
    "test:local": "node scripts/run-local.mjs test",
    "dev:private": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-private.ps1 -Environment dev",
    "test:private": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-private.ps1 -Environment test",
    "dev:private:mac": "bash scripts/start-private-macos.sh dev",
    "test:private:mac": "bash scripts/start-private-macos.sh test",
    "build": "vinext build",
    "build:prod": "node scripts/build-prod.mjs",
    "deploy:prod": "node scripts/build-prod.mjs --deploy",
    "bootstrap:prod-admin": "node --import tsx scripts/bootstrap-prod-admin.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next && stylelint \"app/**/*.css\"",
    "lint:css": "stylelint \"app/**/*.css\"",
    "lint:css:rebaseline": "stylelint \"app/**/*.css\" --suppress=scale-unlimited/declaration-strict-value",
    "test": "tsx --test tests/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "verify:dev": "node scripts/verify-dev-workflow.mjs",
    "check:design": "node scripts/check-design.mjs",
    "check:visual": "node scripts/check-visual.mjs",
    "check:visual:canary": "node scripts/check-visual.mjs --canary",
    "sync:design": "node scripts/sync-design-canvas.mjs",
    "backup:test": "node scripts/backup-local.mjs test",
    "backup:dev": "node scripts/backup-local.mjs dev",
    "backup:verify": "node scripts/verify-local-backup.mjs",
    "vpn:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-vpn.ps1",
    "vpn:setup:mac": "bash scripts/setup-vpn-macos.sh",
    "vpn:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-vpn.ps1 -ShowPublicIp",
    "vpn:check:mac": "bash scripts/check-vpn-macos.sh --show-public-ip",
    "init-secrets": "node scripts/init-secrets.mjs dev && node scripts/init-secrets.mjs test",
    "verify:admin": "node scripts/verify-admin-actions.mjs"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@eslint/js": "9.39.4",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "stylelint": "^17.15.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vinext": "1.0.0-beta.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
