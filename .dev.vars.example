# Optional aggregator credentials for Adzuna and local-administrator Careerjet discovery.
#
# `npm run init-secrets` creates `.dev.vars.dev` and `.dev.vars.test` and copies
# non-session values from a legacy `.dev.vars` when one exists. Fill in either
# environment file as needed, then restart that local environment.
# All `.dev.vars*` files except this example are gitignored; never commit real keys.
#
# Without these, the Adzuna and Careerjet sources simply report themselves
# "unavailable" in the search report. Nothing else breaks, and every other
# source keeps working.
#
# Adzuna - https://developer.adzuna.com/  (free, instant, no card)
#   Free tier: 250 requests/day, 25/minute. Covers Switzerland and Netherlands.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Careerjet - https://www.careerjet.com/partners/api/ (publisher account)
#   LOCAL ADMINISTRATOR ONLY. Do not set these variables in a hosted/public
#   environment. The current API gives every publisher website a unique key and
#   requires the real user IP, user agent and triggering page Referer.
#   v4 API: the key is sent as the HTTP Basic Auth username.
#   See docs/ARCHITECTURE.md 7b before enabling it.
CAREERJET_API_KEY=

# Must be an actual triggering page on the publisher website registered for the key.
CAREERJET_REFERER=
# Must be the real IP of the administrator whose action triggered the query and
# must also satisfy any IP declaration attached to the publisher account.
CAREERJET_USER_IP=

# Each local environment gets a different value from `npm run init-secrets`.
SESSION_SECRET=
# 'true' lets additional local accounts register. The first account on a fresh
# environment is always allowed and becomes the administrator.
ALLOW_SIGNUPS=false

# Indeed: explicit LOCAL administrator experiment only. Never put actual values in Git.
# VPN optional for Indeed only (owner decision 2026-09-20). See docs/INDEED_TESTING.md.
INDEED_ENABLED=false
INDEED_LOCAL_ONLY=false
INDEED_APP_IDENTITY_APPROVED=false
INDEED_API_KEY=
INDEED_USER_AGENT=
INDEED_APP_INFO=

# Turnstile bot protection for registration (#171). The sitekey is public; the secret key is
# owner-set and never committed — `wrangler secret put TURNSTILE_SECRET_KEY`.
# Leave both empty for local development: the app then uses Turnstile's documented
# always-pass test pair, honored on this computer only. Set the test secret below to exercise
# the real verification round trip locally; set both to real values before any public use.
# Test credentials: https://developers.cloudflare.com/turnstile/troubleshooting/testing/
#   always-pass sitekey: 1x00000000000000000000AA
#   always-pass secret:  1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
