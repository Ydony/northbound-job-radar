# Optional free aggregator credentials for Adzuna and Careerjet.
#
# Copy this file to `.dev.vars` and fill in the values, then restart `npm run dev`.
# `.dev.vars` is gitignored; never commit real keys.
#
# Without these, the Adzuna and Careerjet sources simply report themselves
# "unavailable" in the search report. Nothing else breaks, and every other
# source keeps working.
#
# Adzuna - https://developer.adzuna.com/  (free, instant, no card)
#   Free tier: 250 requests/day, 25/minute. Covers Switzerland and Netherlands.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Careerjet - https://www.careerjet.com/partners/api/ (free publisher account)
#   v4 API: key is sent as HTTP Basic Auth username. Key is licensed to the
#   website you registered - see docs/ARCHITECTURE.md 7b.
#   Free tier: ~1000 requests/hour. Covers Switzerland and Netherlands.
CAREERJET_API_KEY=

# Careerjet binds the key to the website you registered and enforces it via the
# Referer header; requests without a matching referrer are refused with HTTP 403.
CAREERJET_REFERER=
# Careerjet also requires the end user's IP on every query, and must match a
# declared "Server IP address" in your partner account.
CAREERJET_USER_IP=

# Session cookie signing key. Generate with `npm run init-secrets`.
SESSION_SECRET=
# 'true' lets anyone register. Closed by default: the first account is created on a fresh
# install, and after that a public deployment cannot be signed up to by strangers.
ALLOW_SIGNUPS=false
